<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" 
            stylesheets="@../css/main.css, @../css/components.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agriloop.controller.DashboardViewController">
    
    <VBox spacing="24.0" style="-fx-padding: 0 8px 32px 0;">
        <!-- Welcome Hero Banner -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card" 
              style="-fx-background-color: linear-gradient(to right, #0F172A, #1E293B); -fx-padding: 24px 28px;">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #34D399; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-transform: uppercase;" text="DIGITAL BIO-ECONOMY MARKETPLACE" />
                <Label fx:id="greetingHeaderLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="Welcome back" />
                <Label fx:id="greetingSubtitleLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 13.5px;" text="Monetize crop residues, discover sustainable raw materials, and prevent field burning." />
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="heroActionBtn3" styleClass="btn-secondary" text="Action 3">
                    <graphic>
                        <StackPane fx:id="heroActionIconBox3" />
                    </graphic>
                </Button>
                <Button fx:id="heroActionBtn2" styleClass="btn-secondary" text="Action 2">
                    <graphic>
                        <StackPane fx:id="heroActionIconBox2" />
                    </graphic>
                </Button>
                <Button fx:id="heroActionBtn1" styleClass="btn-primary" text="Action 1">
                    <graphic>
                        <StackPane fx:id="heroActionIconBox1" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- Metric KPI Cards Row -->
        <VBox spacing="10.0">
            <Label fx:id="kpiSectionTitle" styleClass="heading-3" text="Performance Overview" />
            <HBox fx:id="statsContainer" spacing="14.0" />
        </VBox>

        <!-- Activity Section -->
        <VBox spacing="12.0">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="activitySectionTitle" styleClass="heading-3" text="Recent Activity" />
            </HBox>
            
            <VBox fx:id="recentActivityBox" alignment="CENTER" minHeight="180.0" spacing="10.0" />
        </VBox>
    </VBox>
</ScrollPane>
