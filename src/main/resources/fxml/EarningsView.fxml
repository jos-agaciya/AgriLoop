<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" 
            stylesheets="@../css/main.css, @../css/components.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agriloop.controller.EarningsViewController">
    
    <VBox spacing="20.0" style="-fx-padding: 0 8px 32px 0;">
        <VBox spacing="2.0">
            <Label styleClass="heading-2" text="Earnings &amp; Payouts" />
            <Label styleClass="subheading" text="View financial statements, escrow releases, and payout history" />
        </VBox>

        <!-- Earnings Summary Cards -->
        <HBox fx:id="earningsStatsRow" spacing="16.0" />

        <!-- Transactions Ledger Container -->
        <VBox fx:id="transactionsContainer" alignment="CENTER" minHeight="260.0" spacing="12.0" />
    </VBox>
</ScrollPane>
