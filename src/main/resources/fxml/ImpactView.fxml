<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" 
            stylesheets="@../css/main.css, @../css/components.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agriloop.controller.ImpactViewController">
    
    <VBox spacing="20.0" style="-fx-padding: 0 8px 32px 0;">
        <VBox spacing="2.0">
            <Label styleClass="heading-2" text="Sustainability &amp; CO₂ Offset Tracking" />
            <Label styleClass="subheading" text="Rule-based environmental accounting &amp; circular economy analytics" />
        </VBox>

        <!-- Environmental Metrics Grid -->
        <HBox fx:id="impactStatsRow" spacing="16.0" />

        <!-- History Ledger -->
        <VBox spacing="10.0">
            <Label styleClass="heading-3" text="Verified Offset History" />
            <VBox fx:id="impactHistoryContainer" alignment="CENTER" minHeight="240.0" spacing="12.0" />
        </VBox>
    </VBox>
</ScrollPane>
