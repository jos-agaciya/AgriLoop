<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" 
            stylesheets="@../css/main.css, @../css/components.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.agriloop.controller.OrdersViewController">
    
    <VBox spacing="20.0" style="-fx-padding: 0 8px 32px 0;">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label styleClass="heading-2" text="My Procurement Orders" />
                <Label styleClass="subheading" text="Track active purchasing contracts, seller approvals, and logistics progress" />
            </VBox>
            <Button fx:id="refreshBtn" styleClass="btn-secondary" text="Refresh">
                <graphic>
                    <StackPane fx:id="refreshIconBox" />
                </graphic>
            </Button>
        </HBox>

        <!-- Orders Container -->
        <VBox fx:id="ordersContainer" alignment="CENTER" minHeight="300.0" spacing="14.0" />
    </VBox>
</ScrollPane>
